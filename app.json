{
  "expo": {
    "name": "San Isidro eBarangay",
    "slug": "barangay-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sanisidro.ebrgy",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow camera access to complete a brief profile-photo movement check and capture your profile photo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sanisidro.ebrgy",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-status-bar",
      "@react-native-google-signin/google-signin",
      "./plugins/with-google-play-services-visibility",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "kotlinVersion": "2.2.21"
          }
        }
      ],
      "./plugins/with-vision-camera-android-toolchain"
    ],
    "scheme": "barangay",
    "extra": {
      "eas": {
        "projectId": "df1e7c8e-4618-490b-b4f7-920dd6f4d43f"
      }
    }
  }
}
